generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  name                   String?
  avatarUrl              String?
  phone                  String?
  bio                    String?
  department             String?
  password               String
  role                   String                  @default("CUSTOMER")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  targetConversations    Conversation[]          @relation("TargetConversations")
  userConversations      Conversation[]          @relation("UserConversations")
  mallAds                MallAd[]                @relation("AdminAds")
  sentMessages           Message[]               @relation("SentMessages")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  notificationPrefs      NotificationPref[]
  publicViewCarousels    PublicViewCarousel[]
  publicViewConfigs      PublicViewConfig[]
  reviews                Review[]
  tenant                 Tenant?
  isBlacklisted          Boolean                 @default(false)
  commentStatus          String                  @default("ACTIVE")
  commentRestrictedUntil DateTime?
  eventInquiries         EventInquiry[]
  lostAndFoundItems      LostAndFoundItem[]
  chatBlocksMade         BlockedChatUser[]       @relation("ChatBlocksMade")
  chatBlocksReceived     BlockedChatUser[]       @relation("ChatBlocksReceived")
  conversationReads      ConversationRead[]
  favorites              Favorite[]
}

model Tenant {
  id          String        @id @default(uuid())
  shopName    String
  unitId      String
  isOpen      Boolean       @default(true)
  description String?
  logoUrl     String?
  galleryUrls String[]      @default([])
  category    String        @default("Fashion")
  phone        String?
  openingHours String?
  userId      String        @unique
  status      String        @default("ACTIVE")
  products    Json          @default("[]")
  postSales   Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promos      TenantPromo[]
  invoices    Invoice[]
  reviews     Review[]
  favoritedBy Favorite[]
}

/// A customer's favourite shop.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  month           String
  amount          Float
  status          String   @default("PENDING")
  dueDate         DateTime
  description     String?
  depositSlipUrl  String?
  storageKey      String?
  referenceNo     String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AreaSlot {
  id            String         @id @default(uuid())
  unit_id       String         @unique
  status        String         @default("AVAILABLE")
  sqm_size      Float
  base_rent     Float
  space_images  String[]       @default([])
  features      String[]       @default([])
  tenant_id     String?
  floor         String         @default("ground")
  category      String         @default("retail")
  x             Float          @default(0)
  y             Float          @default(0)
  width         Float          @default(120)
  height        Float          @default(80)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model MallAd {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  linkUrl     String?  @default("/public-view")
  priority    String   @default("MEDIUM")
  startDate   DateTime
  endDate     DateTime
  isGlobal    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  adminId     String
  storageKey  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User     @relation("AdminAds", fields: [adminId], references: [id])
}

model TenantPromo {
  id          String   @id @default(uuid())
  title       String
  description String?
  promoImage  String?
  promoVideo  String?
  category    String
  status      String   @default("PENDING")
  mediaType   String   @default("IMAGE")
  startDate   DateTime
  endDate     DateTime
  tenantId    String
  storageKey  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String    @id @default(uuid())
  type        String
  userId      String
  targetId    String
  spaceSlotId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  areaSlot    AreaSlot? @relation(fields: [spaceSlotId], references: [id])
  reads       ConversationRead[]
  target      User      @relation("TargetConversations", fields: [targetId], references: [id], onDelete: Cascade)
  user        User      @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  content        String       @default("")
  imageUrl       String?
  conversationId String
  senderId       String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// When `user` last read `conversation` — messages after it are unread.
model ConversationRead {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  lastReadAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

/// Messaging-only block: `blocker` stops receiving chat messages from `blocked`.
/// Unlike `User.isBlacklisted`, the account itself stays active.
model BlockedChatUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("ChatBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("ChatBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model SiteConfig {
  id              String   @id @default("singleton")
  heroTitle       String   @default("Experience the Future of Shopping.")
  heroSubtitle    String   @default("Discover world-class retail, dining, and workspace solutions at SR Mall.")
  heroBadge       String   @default("Professional Mall Management System")
  heroBgUrl       String?
  heroOverlayDark Int      @default(40)
  primaryBtnText  String   @default("Explore Now")
  isMaintenance   Boolean  @default(false)
  defaultAdTitle  String   @default("Luxe Summer Sale")
  defaultAdDesc   String   @default("Experience up to 70% off on all premium luxury brands.")
  defaultAdImage  String?
  defaultAdCta    String   @default("View Directory")
  updatedAt       DateTime @updatedAt
}

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  newBookingInquiry    Boolean  @default(true)
  feedbackSpamDetected Boolean  @default(true)
  expiringContracts    Boolean  @default(true)
  overdueRentPayments  Boolean  @default(true)
  adSubmissionReceived Boolean  @default(false)
  systemHealthReports  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-user, per-alert notification preferences.
// One row per (user, alert type) so channels (IN_APP / EMAIL / SMS) can be
// stored per alert instead of one boolean column per alert.
//
// `NotificationPreference` (the legacy one-column-per-alert table) is kept for
// backward compatibility and is used to backfill these rows on first read.
model NotificationPref {
  id        String   @id @default(uuid())
  userId    String
  type      String
  enabled   Boolean  @default(true)
  channels  String[] @default(["IN_APP"])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  /// App-relative page to open when the notification is clicked
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  tenantId   String?  // Optional: Null means it's a general mall review
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  isSpam     Boolean  @default(false)
  /// The shop's public reply (one per review)
  reply        String?
  repliedAt    DateTime?
  /// Set when the shop reports the review to the mall admin
  reportedAt   DateTime?
  reportReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model PublicViewConfig {
  id                    String   @id @default(uuid())
  logoUrl               String?
  contactEmail          String?
  contactPhone          String?
  contactAddress        String?
  heroTitle             String?
  heroSubtitle          String?
  heroBgUrl             String?
  heroBadge             String?
  heroOverlayDark       Int      @default(40)
  adminId               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  aboutDescription      String?
  aboutImageUrl         String?
  aboutTitle            String?
  companyName           String?
  contactDescription    String?
  contactTitle          String?
  featuredVideoUrl      String?
  videoDescription      String?
  videoTitle            String?
  themeColor            String?
  googleMapsEmbedUrl    String?
  googleMapsApiKey      String?
  paymentGatewayProvider String?
  paymentGatewayApiKey  String?
  footerDescription     String?
  footerInstagram       String?
  footerFacebook        String?
  footerWebsite         String?
  footerCopyrightText   String?
  footerAddress         String?
  footerPhone           String?
  footerEmail           String?
  footerOpeningHours    String?
  admin                 User?    @relation(fields: [adminId], references: [id])
}

model PublicViewCarousel {
  id          String    @id @default(uuid())
  title       String
  description String
  imageUrl    String
  linkUrl     String?
  isActive    Boolean   @default(true)
  adminId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  endDate     DateTime?
  priority    Int       @default(0)
  startDate   DateTime?
  storageKey  String?
  admin       User?     @relation(fields: [adminId], references: [id])
}

model EventInquiry {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  eventDate DateTime
  eventTime String
  eventName String?
  message   String?
  imageUrl  String?
  storageKey String?
  status    String   @default("PENDING")
  fbAccount String?
  contactNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model LostAndFoundItem {
  id          String   @id @default(uuid())
  type        String   // "LOST" or "FOUND"
  title       String
  description String?
  location    String
  date        DateTime
  time        String?
  status      String   @default("PENDING") // PENDING, RESOLVED, UNCLAIMED, LOOKING
  imageUrl    String?
  storageKey  String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Permanent snapshot taken whenever a tenant leaves (see lib/tenant-history.ts).
model TenantHistory {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  shopName     String
  ownerName    String?
  ownerEmail   String?
  unitId       String?
  floor        String?
  category     String?
  logoUrl      String?
  leaseStart   DateTime
  endedAt      DateTime @default(now())
  reason       String
  note         String?
  totalPaid    Float    @default(0)
  outstanding  Float    @default(0)
  invoiceCount Int      @default(0)
  avgRating    Float    @default(0)
  reviewCount  Int      @default(0)
  endedById    String?
  endedByName  String?
  createdAt    DateTime @default(now())

  @@index([endedAt])
  @@index([tenantId])
}

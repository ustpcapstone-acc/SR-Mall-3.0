# 🔐 SR-Mall MASTER Environment Variables (.env.example)

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Next.js & App ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Links inside emails should always point at the public site.
EMAIL_BASE_URL="https://www.sophieredmall.com"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ml_default"

# --- Gmail ---
GMAIL_USER="your-address@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# --- Legacy/Cloud provider toggle ---
NEXT_PUBLIC_CLOUD_PROVIDER="cloudinary"
NEXT_PUBLIC_CLOUD_URL="http://localhost:3000/uploads"

# --- Supabase webhook (/api/send-welcome-email); unset = every call refused ---
SUPABASE_WEBHOOK_SECRET=

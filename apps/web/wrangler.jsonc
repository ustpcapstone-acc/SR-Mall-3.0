{
  "$schema": "node_modules/wrangler/config-schema.json",
  // SR Mall on Cloudflare Workers (built by `npm run cf:build`, see open-next.config.ts).
  "name": "sr-mall",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Same daily jobs as vercel.json (UTC); handled in worker.ts.
  "triggers": {
    "crons": ["0 0 * * *", "0 1 * * *", "0 2 * * *"]
  }
}
